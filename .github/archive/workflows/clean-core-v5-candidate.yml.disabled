          retention-days: 14
      - name: Upload exhaustive automatic wink part 02
        if: always() && steps.profile_diagnostics.outcome == 'success' && steps.profile_diagnostics.outputs.part_02 == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-all-winks-part-02-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-profile-diagnostics/parts/part-02/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Upload exhaustive automatic wink part 03
        if: always() && steps.profile_diagnostics.outcome == 'success' && steps.profile_diagnostics.outputs.part_03 == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-all-winks-part-03-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-profile-diagnostics/parts/part-03/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Upload exhaustive automatic wink part 04
        if: always() && steps.profile_diagnostics.outcome == 'success' && steps.profile_diagnostics.outputs.part_04 == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-all-winks-part-04-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-profile-diagnostics/parts/part-04/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Upload exhaustive automatic wink part 05
        if: always() && steps.profile_diagnostics.outcome == 'success' && steps.profile_diagnostics.outputs.part_05 == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-all-winks-part-05-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-profile-diagnostics/parts/part-05/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Upload exhaustive automatic wink part 06
        if: always() && steps.profile_diagnostics.outcome == 'success' && steps.profile_diagnostics.outputs.part_06 == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-all-winks-part-06-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-profile-diagnostics/parts/part-06/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Upload exhaustive automatic wink part 07
        if: always() && steps.profile_diagnostics.outcome == 'success' && steps.profile_diagnostics.outputs.part_07 == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-all-winks-part-07-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-profile-diagnostics/parts/part-07/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Upload exhaustive automatic wink part 08
        if: always() && steps.profile_diagnostics.outcome == 'success' && steps.profile_diagnostics.outputs.part_08 == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-all-winks-part-08-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-profile-diagnostics/parts/part-08/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Select exactly 70000 admitted real photographs
        if: needs.preflight.outputs.diagnostic_only == 'false'
        env:
          PREVIOUS_SELECTION_REVIEW: ${{ needs.preflight.outputs.previous_review_path }}
        run: |
          review_args=(--selection-review data/catalog-selection-reviewed.json --wink-review data/catalog-wink-expression-reviewed.json)
          if test -n "$PREVIOUS_SELECTION_REVIEW"; then
            review_args+=(--previous-selection-review "$PREVIOUS_SELECTION_REVIEW")
          fi
          python tools/run_build_clean_core_v3_real_only.py \
            work/clean-v5-build \
            --catalog current=public/seed-catalog \
            --catalog ffhq=work/source-catalogs/ffhq-main \
            --catalog wink-extras=work/source-catalogs/wink-extras \
            --target-total 70000 \
            --face-attribute-model "$ATTRIBUTE_MODEL_PATH" \
            --candidate-audit work/clean-v5-audit/candidate-audit.json \
            "${review_args[@]}"
      - name: Validate assembled catalog structure
        if: needs.preflight.outputs.diagnostic_only == 'false'
        run: |
          node tools/validate_face_catalog.mjs work/clean-v5-build/catalog \
            | tee work/clean-v5-build/catalog-validation.json
      - name: Repack the selected photos by pose cell
        if: needs.preflight.outputs.diagnostic_only == 'false'
        run: |
          node tools/repack-live-pose-packs.mjs \
            work/clean-v5-build/catalog \
            work/clean-v5-candidate/catalog
          cp work/clean-v5-build/audit.json work/clean-v5-candidate/catalog/clean-core-audit.json
      - name: Validate the final physical catalog and admission correspondence
        if: needs.preflight.outputs.diagnostic_only == 'false'
        env:
          PREVIOUS_SELECTION_REVIEW: ${{ needs.preflight.outputs.previous_review_path }}
        run: |
          node tools/validate_face_catalog.mjs work/clean-v5-candidate/catalog \
            | tee work/clean-v5-candidate/catalog-validation.json
          review_args=(--selection-review data/catalog-selection-reviewed.json --wink-review data/catalog-wink-expression-reviewed.json)
          if test -n "$PREVIOUS_SELECTION_REVIEW"; then
            review_args+=(--previous-selection-review "$PREVIOUS_SELECTION_REVIEW")
          fi
          python tools/validate_clean_core_admission.py \
            --catalog work/clean-v5-candidate/catalog \
            --candidate-audit work/clean-v5-audit/candidate-audit.json \
            --face-attribute-model "$ATTRIBUTE_MODEL_PATH" \
            --source current=public/seed-catalog \
            --source ffhq=work/source-catalogs/ffhq-main \
            --source wink-extras=work/source-catalogs/wink-extras \
            "${review_args[@]}" \
            --target-total 70000 \
            | tee work/clean-v5-candidate/admission-validation.json
      - name: Bind wink support to the validated final catalog
        if: needs.preflight.outputs.diagnostic_only == 'false'
        run: |
          node --experimental-strip-types scripts/rebuild-clean-wink-support.mjs \
            work/clean-v5-candidate/catalog \
            work/clean-v5-candidate/wink-support/v1
      - name: Package complete candidate and evidence for subsequent review
        if: needs.preflight.outputs.diagnostic_only == 'false'
        run: |
          cp -a work/clean-v5-audit work/clean-v5-candidate/admission
          mkdir -p work/clean-v5-candidate/selection
          cp work/clean-v5-build/audit.json work/clean-v5-candidate/selection/audit.json
          cp work/clean-v5-build/coverage.csv work/clean-v5-candidate/selection/coverage.csv
          cp -a work/clean-v5-build/review work/clean-v5-candidate/selection/review
          cp data/catalog-visibility-reviewed.json work/clean-v5-provenance/
          cp data/catalog-selection-reviewed.json work/clean-v5-provenance/
          cp data/catalog-wink-expression-reviewed.json work/clean-v5-provenance/
          cp data/catalog-quality/existing-audit-evidence.json.gz work/clean-v5-provenance/
          cp .github/workflows/clean-core-v5-candidate.yml work/clean-v5-provenance/workflow.yml
          python - <<'PY'
          import hashlib
          import json
          import os
          import sys
          from pathlib import Path

          sys.path.insert(0, str(Path('tools').resolve()))
          from clean_core_selection_review import SelectionReview, WinkExpressionReview
          from validate_clean_core_admission import validate_wink_review_binding

          def digest(file):
              value = hashlib.sha256()
              with Path(file).open('rb') as stream:
                  for block in iter(lambda: stream.read(1024 * 1024), b''):
                      value.update(block)
              return value.hexdigest()

          source_paths = {
              'current': 'public/seed-catalog',
              'ffhq': 'work/source-catalogs/ffhq-main',
              'wink-extras': 'work/source-catalogs/wink-extras',
          }
          request = Path('data/clean-core-v5-candidate-request.json')
          request_document = json.loads(request.read_text())
          selection_review_sha256 = digest('data/catalog-selection-reviewed.json')
          if (selection_review_sha256 != request_document.get('selectionReview', {}).get('sha256')
                  or selection_review_sha256 != digest('work/clean-v5-candidate/catalog/selection-review.json')):
              raise ValueError('Additional selection exclusion review changed or is missing from the candidate')
          admission = json.loads(Path('work/clean-v5-audit/candidate-audit.json').read_text())
          previous = request_document['selectionReview']['previous']
          previous_path = Path(previous['path']) if previous is not None else None
          selection_review = SelectionReview('data/catalog-selection-reviewed.json',
                                             digest('work/clean-v5-audit/candidate-audit.json'), admission['recordsSha256'],
                                             previous_path=previous_path)
          selection_review.verify_catalog_files(Path('work/clean-v5-candidate/catalog'))
          if previous_path is not None:
              if digest(previous_path) != previous['sha256']:
                  raise ValueError('Previous selection review changed after preflight')
              Path('work/clean-v5-provenance/catalog-selection-reviewed-previous.json').write_bytes(previous_path.read_bytes())
          previous_review_sha256 = selection_review.document.get('previousReviewSha256')
          wink_review = WinkExpressionReview('data/catalog-wink-expression-reviewed.json',
                                             digest('work/clean-v5-audit/candidate-audit.json'), admission['recordsSha256'])
          if wink_review.sha256 != request_document.get('winkReview', {}).get('sha256'):
              raise ValueError('Wink expression review changed after preflight')
          final_catalog = Path('work/clean-v5-candidate/catalog')
          final_manifest = json.loads((final_catalog / 'manifest.json').read_text())
          selection_audit = json.loads((final_catalog / 'clean-core-audit.json').read_text())
          validate_wink_review_binding(final_manifest, selection_audit, final_catalog, wink_review)
          if final_manifest.get('selectionIdentity', {}).get('winkExpressionReviewSha256') != wink_review.sha256:
              raise ValueError('Final selection identity does not bind the exact wink expression review')
          physical = json.loads((final_catalog / 'clean-admission-validation.json').read_text())
          wink_index = json.loads(Path('work/clean-v5-candidate/wink-support/v1/catalog.json').read_text())
          wink_validation = json.loads(Path('work/clean-v5-candidate/wink-support/v1/audit.json').read_text())
          if (physical.get('status') != 'passed'
                  or physical.get('winkExpressionReviewSha256') != wink_review.sha256
                  or physical.get('allSelectedWinkProfilesHaveReviewedEvidence') is not True
                  or wink_index.get('winkExpressionReviewSha256') != wink_review.sha256
                  or wink_validation.get('winkExpressionReviewSha256') != wink_review.sha256
                  or wink_validation.get('allIndexedWinksHaveReviewedEvidence') is not True):
              raise ValueError('Final physical catalog or specialist index lacks reviewed wink evidence')
          reuse_path = Path('work/clean-v5-provenance/audit-reuse.json')
          reuse = json.loads(reuse_path.read_text()) if reuse_path.is_file() else None
          if reuse is not None:
              audit_root = Path('work/clean-v5-audit')
              actual_files = [{'path': path.relative_to(audit_root).as_posix(), 'bytes': path.stat().st_size, 'sha256': digest(path)}
                              for path in sorted(audit_root.rglob('*')) if path.is_file()]
              if actual_files != reuse['auditFiles']:
                  raise ValueError('Original completed audit bytes changed during selection or packing')
              copied_root = Path('work/clean-v5-candidate/admission')
              copied_files = [{'path': path.relative_to(copied_root).as_posix(), 'bytes': path.stat().st_size, 'sha256': digest(path)}
                              for path in sorted(copied_root.rglob('*')) if path.is_file()]
              if copied_files != reuse['auditFiles']:
                  raise ValueError('Packaged admission differs from the unchanged original completed audit')
              if (digest(audit_root / 'candidate-audit.json') != reuse['candidateAuditSha256']
                      or digest(audit_root / admission['recordsPath']) != reuse['recordsSha256']):
                  raise ValueError('Original completed admission receipt/database changed')
          inference = {
              'mode': 'reused' if reuse is not None else 'fresh',
              'workflowRunId': reuse['originalInference']['runId'] if reuse is not None else int(os.environ['GITHUB_RUN_ID']),
              'workflowRunAttempt': reuse['originalInference']['runAttempt'] if reuse is not None else int(os.environ['GITHUB_RUN_ATTEMPT']),
              'codeCommit': reuse['originalInference']['inferenceCodeCommit'] if reuse is not None else os.environ['GITHUB_SHA'],
              'candidateAuditSha256': digest('work/clean-v5-audit/candidate-audit.json'),
              'recordsSha256': admission['recordsSha256'], 'analysisCodeSha256': admission['analysisCodeSha256'],
              'runnerCodeSha256': admission['runnerCodeSha256'], 'policySha256': admission['policySha256'],
              'controlsSha256': admission['controlsSha256'], 'models': admission['models'],
              'sourceCandidateRows': admission['recordCount'],
              'reuseVerificationSha256': digest(reuse_path) if reuse is not None else None,
              'newInferencePerformedInThisRun': reuse is None,
              'auditRemergedInThisRun': reuse is None,
          }
          selection_sources = (
              'tools/build_clean_core_v3.py', 'tools/clean_core_policy_v2.py', 'tools/clean_core_policy_v3.py',
              'tools/clean_core_selection_review.py',
              'tools/run_build_clean_core_v3_real_only.py', 'tools/run_build_clean_core_v3_repair.py',
              'tools/validate_clean_core_admission.py', 'tools/repack-live-pose-packs.mjs',
              'scripts/rebuild-clean-wink-support.mjs',
          )
          receipt = {
              'schemaVersion': 1,
              'artifactPurpose': 'physical-catalog-candidate-for-review',
              'workflowRunId': int(os.environ['GITHUB_RUN_ID']),
              'workflowRunAttempt': int(os.environ['GITHUB_RUN_ATTEMPT']),
              'builtFromCommit': os.environ['GITHUB_SHA'],
              'inference': inference,
              'selection': {'codeCommit': os.environ['GITHUB_SHA'],
                            'additionalSelectionExclusionsSha256': selection_review_sha256,
                            'previousAdditionalSelectionExclusionsSha256': previous_review_sha256,
                            'winkExpressionReviewSha256': wink_review.sha256,
                            'codeFilesSha256': {name: digest(name) for name in selection_sources},
                            'selectionAuditSha256': digest('work/clean-v5-build/audit.json')},
              'ffhqSourceCommit': os.environ['FFHQ_SOURCE_COMMIT'],
              'targetTotal': 70000,
              'auditPartitions': int(os.environ['AUDIT_PARTS']),
              'visibilityMaxScore': float(os.environ['VISIBILITY_MAX_SCORE']),
              'sourceManifestSha256': {
                  label: digest(Path(root) / 'manifest.json')
                  for label, root in source_paths.items()
              },
              'attributeModelSha256': digest(os.environ['ATTRIBUTE_MODEL_PATH']),
              'faceModelSha256': digest(os.environ['FACE_MODEL_PATH']),
              'priorYawEvidenceSha256': digest('work/catalog-quality/merged-evidence.json'),
              'reviewedVisibilitySha256': digest('data/catalog-visibility-reviewed.json'),
              'selectionReviewSha256': selection_review_sha256,
              'previousSelectionReviewSha256': previous_review_sha256,
              'winkExpressionReviewSha256': wink_review.sha256,
              'winkExpressionReview': wink_review.stamp(),
              'candidateAuditSha256': digest('work/clean-v5-audit/candidate-audit.json'),
              'candidateManifestSha256': digest('work/clean-v5-candidate/catalog/manifest.json'),
              'winkSupportIndexSha256': digest('work/clean-v5-candidate/wink-support/v1/catalog.json'),
              'requestSha256': digest(request) if request.is_file() else None,
              'runtimeExclusionOverlayRequired': False,
              'selectedPhotoHoldoutReviewed': False,
              'sameVideoComparisonCompleted': False,
              'hostedSiteVerified': False,
              'physicalCameraVerified': False,
              'published': False,
          }
          receipt_path = Path('work/clean-v5-provenance/candidate-receipt.json')
          receipt_path.write_text(
              json.dumps(receipt, ensure_ascii=False, indent=2) + '\n', encoding='utf-8'
          )
          print(json.dumps({'candidateManifestSha256': receipt['candidateManifestSha256'],
                            'generationReceiptSha256': digest(receipt_path), 'inference': inference,
                            'selectionCodeCommit': os.environ['GITHUB_SHA'], 'published': False}))
          if request.is_file():
              Path('work/clean-v5-provenance/request.json').write_bytes(request.read_bytes())
          PY
          cp -a work/clean-v5-provenance work/clean-v5-candidate/provenance
      - name: Upload the complete validated candidate catalog and audit
        if: needs.preflight.outputs.diagnostic_only == 'false'
        uses: actions/upload-artifact@v4
        with:
          name: clean-core-v5-candidate-${{ github.run_id }}-${{ github.run_attempt }}
          path: work/clean-v5-candidate/
          if-no-files-found: error
          compression-level: 0
          retention-days: 30
      - name: Retain diagnostics if candidate generation fails
        uses: actions/upload-artifact@v4
        if: failure() && needs.preflight.outputs.diagnostic_only == 'false'
        with:
          name: clean-core-v5-failure-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            work/clean-v5-audit/
            work/clean-v5-build/audit.json
            work/clean-v5-build/catalog-validation.json
            work/clean-v5-build/coverage.csv
            work/clean-v5-build/review/
            work/clean-v5-candidate/catalog-validation.json
            work/clean-v5-candidate/admission-validation.json
            work/clean-v5-candidate/wink-support/
            work/clean-v5-provenance/
          if-no-files-found: warn
          compression-level: 0
          retention-days: 14
