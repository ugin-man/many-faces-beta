name: Apply deterministic live browser fixes

on:
  push:
    branches: [work/coverage-driven-200k]
    paths:
      - data/live-deterministic-browser-fix-launch.json
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: many-faces-live-deterministic-browser-fix
  cancel-in-progress: true

jobs:
  verify-and-commit:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 2
      - name: Apply idempotent browser fixes
        run: |
          python tools/patch_faithful_camera_start.py
          python tools/normalize_live_deterministic_marker.py
          python tools/patch_live_deterministic_video.py
          python tools/patch_live_review_canvas_mount.py
          python tools/patch_live_review_frame_decode.py
          python tools/patch_live_review_test_hooks.py
          python tools/patch_live_review_lite_lint.py
      - uses: actions/setup-node@v4
        with:
          node-version: 22.13.0
          cache: npm
      - name: Install dependencies
        run: npm ci
      - name: Build routes
        run: npm run build
      - name: Run bounded live tests
        run: |
          node --check scripts/verify-live-video.mjs
          node --check public/faithful-capture-worker-v2.js
          node --experimental-strip-types --test \
            tests/live-review-timeline.test.mjs \
            tests/live-review-local-catalog.test.mjs \
            tests/live-verification-gate.test.mjs \
            tests/live-faithful-delay.test.mjs \
            tests/catalog-worker.test.mjs
      - name: Lint application
        run: npm run lint
      - name: Write verification receipt
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          receipt = {
              "schemaVersion": 1,
              "testedCommit": "${{ github.sha }}",
              "workflowRunId": int("${{ github.run_id }}"),
              "pipeline": "five-second-pose-local-review-v5",
              "frameDecodePolicy": "seek-requestVideoFrameCallback-canvas",
              "firstOutputPolicy": "mount-canvas-then-draw-then-verify",
              "browserVerifier": "scripts/verify-live-video.mjs",
              "progressPolicy": "heartbeat-and-60-second-stall-failure",
              "build": "success",
              "tests": "success",
              "lint": "success",
          }
          Path("data/live-deterministic-browser-fix-result.json").write_text(
              json.dumps(receipt, indent=2) + "\n", encoding="utf-8"
          )
          PY
      - name: Commit verified source
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add \
            app/live/faithful-client.tsx \
            app/live/review-client-lite.tsx \
            app/live/review-client-lite.module.css \
            data/live-deterministic-browser-fix-result.json
          git commit -m "fix(live): verify decoded deterministic video in browser" || exit 0
          git fetch origin work/coverage-driven-200k
          git rebase origin/work/coverage-driven-200k
          git push origin HEAD:work/coverage-driven-200k
